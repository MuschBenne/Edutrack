---
import { env } from 'cloudflare:workers';
import Layout from '../../../layouts/Layout.astro';
import FinalGradeForm from '../../../components/FinalGradeForm.astro';
import SessionForm from '../../../components/SessionForm.astro';
import * as coursePage from '../../../db/coursePage';
import { courseLabel } from '../../../db/courses';
import { toChartSessions } from '../../../lib/chartData';
import { addDays, formatMinutes, todayIso } from '../../../lib/dates';
import { parseId } from '../../../lib/ids';
import { jsonForScript } from '../../../lib/json';
import { studyTypeLabel } from '../../../lib/studyTypes';

const user = Astro.locals.user!;
const courseId = parseId(Astro.params.id);
const data = courseId && (await coursePage.load(env.DB, user.id, courseId, addDays(todayIso(), -6), user.isAdmin));
if (!data) return new Response('Course not found, or you are not registered to it.', { status: 404 });

const { course, finalGrade, stats, sessions, allSessions } = data;
const newestFirst = [...sessions].reverse();

const error = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.has('saved');

// Efter "Add course" eller "Register" på /app/register-course
const joinedMessages: Record<string, string> = {
	created: 'Course created. You are registered to it.',
	existing: 'This course already existed, so you have been added to it.',
	already: 'This course already exists and you are already registered to it.',
	registered: 'You are now registered to this course.',
};
const joinedKey = Astro.url.searchParams.get('joined') ?? '';
// hasOwn så att t.ex. ?joined=valueOf inte träffar en ärvd metod
const joined = Object.hasOwn(joinedMessages, joinedKey) ? joinedMessages[joinedKey] : null;
---

<Layout title={course.name} active="courses">
	<script type="application/json" id="course-sessions" set:html={jsonForScript(toChartSessions(sessions))} />
	{allSessions && <script type="application/json" id="all-course-sessions" set:html={jsonForScript(allSessions)} />}
	<script>
		import '../../../scripts/courseCharts';
	</script>

	<main class="container page">
		<div class="page-head">
			<div>
				<a class="back-link" href="/app">← My courses</a>
				<h1>{course.name}</h1>
				<p class="muted">{courseLabel(course)}</p>
			</div>
			<a class="btn btn-primary" href="#add-session">Add study session</a>
		</div>

		{joined && <p class="notice" role="status">{joined}</p>}

		<div class="stats">
			<div class="stat">
				<span class="stat-label">Last 7 days</span>
				<span class="stat-value">{formatMinutes(stats.recentMinutes)}</span>
			</div>
			<div class="stat">
				<span class="stat-label">Total</span>
				<span class="stat-value">{formatMinutes(stats.totalMinutes)}</span>
			</div>
			<div class="stat">
				<span class="stat-label">Sessions</span>
				<span class="stat-value">{stats.sessionCount}</span>
			</div>
			<div class="stat">
				<span class="stat-label">Final grade</span>
				<span class="stat-value">{finalGrade ?? '–'}</span>
			</div>
			<div class="stat">
				<span class="stat-label">Avg. session rating</span>
				<span class="stat-value">{stats.averageRating?.toFixed(1) ?? '–'} <small>/ 5</small></span>
			</div>
		</div>

		<div class="course-layout">
			<div class="course-main">
				<section class="card">
					<div class="card-head">
						<h2>Study time per week</h2>
						<span class="subtle">Minutes, by type</span>
					</div>
					<div class="chart-box"><canvas id="weeklyGraf"></canvas></div>
				</section>

				<section class="card">
					<div class="card-head">
						<h2>Time by type</h2>
						<span class="subtle">All sessions</span>
					</div>
					<div class="chart-box-small"><canvas id="totalGraf"></canvas></div>
				</section>

				<section class="section">
					<h2>Sessions</h2>
					{
						newestFirst.length > 0 ? (
							<div class="table-wrap">
								<table class="table table-compact">
									<thead>
										<tr>
											<th>Date</th>
											<th>Type</th>
											<th class="right">Duration</th>
											<th class="right">Rating</th>
											<th class="right">Physical</th>
											<th class="right">Mental</th>
										</tr>
									</thead>
									<tbody>
										{newestFirst.map((s) => (
											<tr>
												<td>{s.studiedOn}</td>
												<td>{studyTypeLabel(s.type)}</td>
												<td class="right">{formatMinutes(s.minutes)}</td>
												<td class="right">{s.rating}</td>
												<td class="right">{s.health ?? '–'}</td>
												<td class="right">{s.mentalHealth ?? '–'}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						) : (
							<div class="card empty">No sessions registered yet.</div>
						)
					}
				</section>

				{
					allSessions && (
						<section class="card">
							<div class="card-head">
								<h2>All users' sessions</h2>
								<span class="subtle">Admin only</span>
							</div>
							<div class="chart-box-small"><canvas id="allCourseGraf"></canvas></div>
						</section>
					)
				}
			</div>

			<aside class="course-aside">
				<div class="card" id="add-session">
					<h2>Add study session</h2>
					<SessionForm courseId={course.id} error={error} saved={saved} />
				</div>
				<div class="card" id="final-grade">
					<h2>Final grade</h2>
					<FinalGradeForm course={course} finalGrade={finalGrade} status={Astro.url.searchParams.get('grade')} />
				</div>
				<div class="card">
					<h2>Leave course</h2>
					<p class="muted">Unregistering deletes your sessions and final grade in this course.</p>
					<form method="post" action="/api/enrollments" onsubmit="return confirm('Unregister and delete your sessions in this course?')">
						<input type="hidden" name="action" value="unregister" />
						<input type="hidden" name="courseId" value={course.id} />
						<button type="submit" class="btn btn-danger">Unregister</button>
					</form>
				</div>
			</aside>
		</div>
	</main>
</Layout>
