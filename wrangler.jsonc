{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "edutrack",
	"main": "@astrojs/cloudflare/entrypoints/server",
	// Egen domän i stället för *.workers.dev; Cloudflare skapar DNS-posten och certifikatet.
	"routes": [{ "pattern": "edutrack.rosenbergab.com", "custom_domain": true }],
	"workers_dev": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edutrack",
			"database_id": "13a974ef-4d9c-490c-9628-c8faca4918d4",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
