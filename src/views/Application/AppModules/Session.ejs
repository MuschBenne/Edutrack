<%
  const scales = [
    { name: "rating", legend: "How did the session go?", low: "Poorly", high: "Very well" },
    { name: "health", legend: "Physical wellbeing", low: "Sick", high: "Feeling good" },
    { name: "mentalHealth", legend: "Mental wellbeing", low: "Stressed", high: "Energized" }
  ];
%>
<form class="form" id="sessionForm" onsubmit="event.preventDefault(); addSession();">
  <label class="field">
    Duration (minutes)
    <input id="duration" type="number" min="1" step="1" inputmode="numeric" placeholder="85">
  </label>

  <label class="field">
    Type
    <select name="sessiontype" id="sessiontype">
      <option value="Selfstudies">Self studies</option>
      <option value="Lecture">Lecture</option>
      <option value="Lesson">Lesson</option>
      <option value="Homework">Homework</option>
      <option value="Labs">Labs</option>
      <option value="Project">Project</option>
      <option value="TentaP">Exam prep</option>
      <option value="Other">Other</option>
    </select>
  </label>

  <% scales.forEach(function(scale) { %>
    <fieldset class="scale">
      <legend><%= scale.legend %></legend>
      <div class="scale-options">
        <% for (let i = 1; i <= 5; i++) { %>
          <label>
            <input type="radio" name="<%= scale.name %>" value="<%= i %>">
            <span><%= i %></span>
          </label>
        <% } %>
      </div>
      <div class="scale-ends"><span><%= scale.low %></span><span><%= scale.high %></span></div>
    </fieldset>
  <% }); %>

  <p id="sessionMessage" class="form-message" role="alert"></p>
  <button type="submit" class="btn btn-accent btn-lg btn-block">Save session</button>

  <script>
	// Read the selected value of a 1–5 scale, or null if none is picked
	function scaleValue(name) {
		const checked = document.querySelector('input[name="' + name + '"]:checked');
		return checked ? checked.value : null;
	}

	// Function to add a new study session by sending data to the server
	async function addSession() {
		const message = document.getElementById("sessionMessage");
		message.innerText = "";

		// Get the duration of the study session from the input field
		let duration = document.getElementById("duration").value;

		// Convert the duration value to a number for validation and submission
		let durationNum = Number(duration);

		// Check if the duration is a valid positive whole number
		if (durationNum <= 0 || !Number.isInteger(durationNum)) {
		    message.innerText = "Enter the duration as a whole number of minutes, greater than 0.";
		    return; // Stop function execution if the duration is invalid
		}

		const rating = scaleValue("rating");
		const health = scaleValue("health");
		const mentalHealth = scaleValue("mentalHealth");
		if (!rating || !health || !mentalHealth) {
		    message.innerText = "Pick a value from 1 to 5 for each scale.";
		    return;
		}

		// Make an asynchronous POST request to the server with the study session data
		let response = await fetch("/app?action=addStudySession", {
			method: "POST",
			body: JSON.stringify({
				// Send the collected session data as JSON
				time: durationNum,
				type: document.getElementById("sessiontype").value,
				rating: rating,
				health: health,
				mentalHealth: mentalHealth,
				courseId: "<%- courseData.courseId %>"
			}),
			headers: {
				"Content-type": "application/json; charset=UTF-8" // Set content type to JSON
			}
		});

		// Parse the JSON response from the server
		let responseJSON = await response.json();

		if (response.ok) {
			// Reload so the key figures, charts and session table include the new session
			window.location.reload();
		} else {
			message.innerText = responseJSON.message;
		}
	}
  </script>
</form>
