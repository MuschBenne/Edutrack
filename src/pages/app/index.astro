---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { courseOverview } from '../../db/stats';
import { addDays, formatMinutes, relativeDay, todayIso } from '../../lib/dates';

const user = Astro.locals.user!; // middleware har redan skickat utloggade till /login
const today = todayIso();
const rows = await courseOverview(env.DB, user.id, addDays(today, -6));

// Efter avregistrering, eller när en kurs man stod på inte längre finns
const messages: Record<string, { text: string; error: boolean }> = {
	unregistered: { text: 'You have been unregistered and your sessions in the course were deleted.', error: false },
	notenrolled: { text: 'You are no longer registered to that course. Nothing was saved.', error: true },
};
const msgKey = Astro.url.searchParams.get('msg') ?? '';
const message = Object.hasOwn(messages, msgKey) ? messages[msgKey] : null;
---

<Layout title="My courses" active="courses">
	<main class="container page">
		<div class="page-head">
			<div>
				<p class="muted">Welcome back, {user.username}</p>
				<h1>My courses</h1>
			</div>
			<a class="btn" href="/app/register-course">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3v10M3 8h10"></path></svg>
				Register to course
			</a>
		</div>

		{message && <p class:list={['notice', { 'notice-error': message.error }]} role="status">{message.text}</p>}

		{
			rows.length > 0 ? (
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>Course</th>
								<th>Code</th>
								<th>Term</th>
								<th class="right">Last 7 days</th>
								<th class="right">Sessions</th>
								<th>Last session</th>
								<th>Grade</th>
								<th />
							</tr>
						</thead>
						<tbody>
							{rows.map((row) => {
								const href = `/app/course/${row.courseId}`;
								return (
									<tr>
										<td class="title-cell"><a href={href}>{row.name}</a></td>
										<td class="muted">{row.code}</td>
										<td class="muted">{row.term}</td>
										<td class="right">{row.recentMinutes > 0 ? formatMinutes(row.recentMinutes) : '–'}</td>
										<td class="right">{row.sessionCount}</td>
										<td class="muted">{relativeDay(row.lastStudiedOn, today)}</td>
										<td>{row.finalGrade ?? <span class="muted">–</span>}</td>
										<td class="right"><a href={href}>Open</a></td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			) : (
				<div class="card empty">
					<p>You are not registered to any courses yet.</p>
					<p class="empty-action"><a class="btn btn-primary" href="/app/register-course">Find a course</a></p>
				</div>
			)
		}
	</main>
</Layout>
