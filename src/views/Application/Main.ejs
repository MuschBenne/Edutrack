<%
    // Sessionsnycklar sparas som "Wed_Oct_08_2026"
    const toDate = (key) => new Date(key.replaceAll("_", " "));
    const formatMinutes = (min) => min > 0 ? Math.floor(min / 60) + " h " + String(min % 60).padStart(2, "0") + " min" : "–";
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const weekAgo = new Date(today);
    weekAgo.setDate(today.getDate() - 6);

    const rows = courses.map((course) => {
        let lastSevenDays = 0;
        let sessionCount = 0;
        let lastDate = null;
        for (const key in (course.sessions ?? {})) {
            const date = toDate(key);
            course.sessions[key].forEach((entry) => {
                sessionCount++;
                if (date >= weekAgo) lastSevenDays += Number(entry.time);
            });
            if (!lastDate || date > lastDate) lastDate = date;
        }
        let lastLabel = "–";
        if (lastDate) {
            const days = Math.round((today - lastDate) / 86400000);
            lastLabel = days <= 0 ? "Today" : days === 1 ? "Yesterday" : days + " days ago";
        }
        return { course, lastSevenDays: formatMinutes(lastSevenDays), sessionCount, lastLabel };
    });
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../CommonModules/Head", { title: "My courses" }) %>
</head>
<body>
    <%- include("../CommonModules/Nav", { active: "courses", loggedIn: true }) %>

    <main class="container page">
        <div class="page-head">
            <div>
                <p class="muted">Welcome back, <%= name %></p>
                <h1>My courses</h1>
            </div>
            <a class="btn" href="/app/course_registration">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3v10M3 8h10"/></svg>
                Register to course
            </a>
        </div>

        <% if (rows.length > 0) { %>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th class="right">Last 7 days</th>
                            <th class="right">Sessions</th>
                            <th>Last session</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% rows.forEach(function(row) { %>
                            <tr>
                                <td class="title-cell"><a href="/app/course_page?course=<%= row.course.courseId %>"><%= row.course.name %></a></td>
                                <td class="right"><%= row.lastSevenDays %></td>
                                <td class="right"><%= row.sessionCount %></td>
                                <td class="muted"><%= row.lastLabel %></td>
                                <td class="right"><a href="/app/course_page?course=<%= row.course.courseId %>">Open</a></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="card empty">
                <p>You are not registered to any courses yet.</p>
                <p class="empty-action"><a class="btn btn-primary" href="/app/course_registration">Find a course</a></p>
            </div>
        <% } %>
    </main>

    <%- include("../CommonModules/Footer") %>
</body>
</html>
