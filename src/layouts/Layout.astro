---
// Ersätter CommonModules/Head, Nav och Footer
import { CONTACT_EMAIL } from '../lib/site';
// Typsnitten serveras från vår egen domän i stället för Google Fonts, så besökarens IP inte skickas till Google
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource-variable/source-serif-4/opsz.css';

interface Props {
	title?: string;
	active?: 'home' | 'courses' | 'register-course' | 'admin' | 'account' | 'login';
	bodyClass?: string;
}

const { title, active, bodyClass } = Astro.props;
const user = Astro.locals.user;
const current = (name: Props['active']) => (active === name ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title ? `${title} · EduTrack` : 'EduTrack'}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="stylesheet" href="/master.css" />
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="/">EduTrack</a>
				<nav class="site-nav" aria-label="Main">
					<a href="/" aria-current={current('home')}>Home</a>
					{
						user ? (
							<>
								<a href="/app" aria-current={current('courses')}>My courses</a>
								<a href="/app/register-course" aria-current={current('register-course')}>Register to course</a>
								{user.isAdmin && <a href="/admin" aria-current={current('admin')}>Admin</a>}
								<a href="/app/account" aria-current={current('account')}>Account</a>
								<form method="post" action="/logout" class="nav-form">
									<button type="submit" class="nav-link">Log out</button>
								</form>
							</>
						) : (
							<a href="/login" class="btn btn-primary" aria-current={current('login')}>Log in</a>
						)
					}
				</nav>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="container footer-inner">
				<span class="footer-links">
					<span>EduTrack</span>
					<a href="/privacy">Privacy</a>
					<a href="/terms">Terms</a>
				</span>
				<span>
					Ideas on improvements? Email us at
					<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
				</span>
			</div>
		</footer>
	</body>
</html>
