---
// Nya användare väljer användarnamn, lärosäte och program efter första Google-inloggningen
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import * as universities from '../db/universities';
import { programmesByUniversity } from '../db/users';
import { PENDING_COOKIE, completeOnboarding, getPendingSignup } from '../lib/auth';
import { setSessionCookie } from '../lib/cookies';
import { parseId } from '../lib/ids';
import { jsonForScript } from '../lib/json';

if (Astro.locals.user) return Astro.redirect('/app');

const pendingToken = Astro.cookies.get(PENDING_COOKIE)?.value;
if (!pendingToken) return Astro.redirect('/login');

let error: string | null = null;
let username = '';
let universityId: number | null = null;
let programme = '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	username = String(form.get('username') ?? '');
	universityId = parseId(form.get('universityId'));
	programme = String(form.get('programme') ?? '');

	const result = await completeOnboarding(env.DB, pendingToken, { username, universityId: universityId ?? 0, programme }, env.ADMIN_EMAILS);
	if (result.ok) {
		Astro.cookies.delete(PENDING_COOKIE, { path: '/' });
		setSessionCookie(Astro.cookies, result);
		return Astro.redirect('/app', 303);
	}
	error = result.message;
}

const pending = await getPendingSignup(env.DB, pendingToken);
if (!pending) {
	Astro.cookies.delete(PENDING_COOKIE, { path: '/' });
	return Astro.redirect('/login?error=expired');
}

const [universityList, programmes] = await Promise.all([universities.list(env.DB), programmesByUniversity(env.DB)]);
---

<Layout title="Create account">
	<main class="container auth">
		<div class="card auth-card">
			<h1>Almost done</h1>
			<p class="lead">Signed in as {pending.email}. Tell us a bit about yourself.</p>

			<form class="form" method="post">
				<label class="field">
					Username
					<input type="text" name="username" value={username} autocomplete="username" minlength="5" maxlength="20" required />
					<span class="field-hint">5–20 characters</span>
				</label>
				<label class="field">
					University
					<select name="universityId" id="university" required>
						<option value="" selected={universityId === null}>Pick your university</option>
						{universityList.map((u) => <option value={u.id} selected={u.id === universityId}>{u.name}</option>)}
					</select>
				</label>
				<label class="field">
					Programme
					<input type="text" name="programme" value={programme} list="programme-suggestions" minlength="2" maxlength="80" required />
					<span class="field-hint">E.g. Computer Science. Pick a suggestion if yours is listed.</span>
					<datalist id="programme-suggestions"></datalist>
				</label>
				{error && <p class="form-message" role="alert">{error}</p>}
				<p class="field-hint">
					By creating an account you accept the <a href="/terms" target="_blank">terms</a> and confirm you have read the
					<a href="/privacy" target="_blank">privacy policy</a>.
				</p>
				<button type="submit" class="btn btn-primary btn-lg btn-block">Create account</button>
			</form>
		</div>
	</main>

	<script type="application/json" id="programmes" set:html={jsonForScript(programmes)} />
	<script is:inline>
		// Förslagen beror på valt lärosäte, så listan byts när valet ändras
		const programmes = JSON.parse(document.getElementById('programmes').textContent);
		const select = document.getElementById('university');
		const datalist = document.getElementById('programme-suggestions');
		function updateSuggestions() {
			datalist.replaceChildren(
				...(programmes[select.value] ?? []).map((name) => Object.assign(document.createElement('option'), { value: name })),
			);
		}
		select.addEventListener('change', updateSuggestions);
		updateSuggestions();
	</script>
</Layout>
