---
// Ersätter AppModules/Session.ejs. Vanligt formulär som skickas till /api/sessions, ingen JavaScript behövs.
import { SESSION_ERRORS, type SessionError } from '../lib/sessionForm';
import { STUDY_TYPES } from '../lib/studyTypes';

interface Props {
	courseId: number;
	error?: string | null;
	saved?: boolean;
}

const { courseId, error, saved } = Astro.props;
const message = error && Object.hasOwn(SESSION_ERRORS, error) ? SESSION_ERRORS[error as SessionError] : null;

// Hälsoskalorna är valfria (hälsodata, GDPR art. 9) och har ett förvalt "hoppa över"-alternativ
const scales = [
	{ name: 'rating', legend: 'How did the session go?', low: 'Poorly', high: 'Very well', optional: false },
	{ name: 'health', legend: 'Physical wellbeing', low: 'Sick', high: 'Feeling good', optional: true },
	{ name: 'mentalHealth', legend: 'Mental wellbeing', low: 'Stressed', high: 'Energized', optional: true },
];
---

<form class="form" method="post" action="/api/sessions">
	<input type="hidden" name="courseId" value={courseId} />

	<label class="field">
		Duration (minutes)
		<input name="minutes" type="number" min="1" max="1440" step="1" inputmode="numeric" placeholder="85" required />
	</label>

	<label class="field">
		Type
		<select name="type">
			{Object.entries(STUDY_TYPES).map(([value, label]) => <option value={value}>{label}</option>)}
		</select>
	</label>

	{
		scales.map((scale) => (
			<fieldset class="scale">
				<legend>
					{scale.legend}
					{scale.optional && <span class="muted"> (optional)</span>}
				</legend>
				<div class:list={['scale-options', { 'has-skip': scale.optional }]}>
					{[1, 2, 3, 4, 5].map((i) => (
						<label>
							{/* required på en radioknapp gäller hela gruppen */}
							<input type="radio" name={scale.name} value={i} required={!scale.optional && i === 1} />
							<span>{i}</span>
						</label>
					))}
					{scale.optional && (
						<label>
							<input type="radio" name={scale.name} value="" checked aria-label="Skip" />
							<span>Skip</span>
						</label>
					)}
				</div>
				<div class="scale-ends">
					<span>{scale.low}</span><span>{scale.high}</span>
				</div>
			</fieldset>
		))
	}

	<p class="field-hint">Wellbeing ratings are only used for your own statistics. See the <a href="/privacy">privacy policy</a>.</p>

	{message && <p class="form-message" role="alert">{message}</p>}
	{saved && <p class="form-message form-message-success" role="status">Session saved.</p>}
	<button type="submit" class="btn btn-accent btn-lg btn-block">Save session</button>
</form>
