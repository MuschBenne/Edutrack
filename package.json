{
  "name": "edutrack",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "test": "vitest run",
    "check": "astro check && tsc --noEmit -p test",
    "db:migrate:local": "wrangler d1 migrations apply edutrack --local",
    "db:migrate:remote": "wrangler d1 migrations apply edutrack --remote",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "astro": "^7.3.8",
    "wrangler": "^4.149.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
